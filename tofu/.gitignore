# ============================================================================
# .gitignore — OpenTofu files to exclude from git
# ============================================================================

# State files (contain sensitive data)
*.tfstate
*.tfstate.backup
*.tfstate.*.backup

# Variable values (contain passwords)
terraform.tfvars
*.auto.tfvars

# OpenTofu directories
.terraform/
.terraform.lock.hcl

# Crash logs
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Plan files
tfplan
*.tfplan
