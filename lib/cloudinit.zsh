#!/usr/bin/env zsh
# cloudinit.zsh — Cloud-init template management

set -euo pipefail

CLOUD_INIT_DIR="${LAB_PROJECT_ROOT}/cloud-init"

# Get user's SSH public key
cloudinit_get_ssh_key() {
    local key=""
    for f in ~/.ssh/id_ed25519.pub ~/.ssh/id_rsa.pub ~/.ssh/id_ecdsa.pub; do
        if [[ -f "${f}" ]]; then
            key=$(cat "${f}")
            break
        fi
    done
    if [[ -z "${key}" ]]; then
        log_warn "No SSH public key found in ~/.ssh/"
        log_warn "VM will not be accessible via SSH until you add a key"
        echo ""
    else
        echo "${key}"
    fi
}

# Generate user-data from template
cloudinit_generate_user_data() {
    log_info "Generating cloud-init user-data..."
    mkdir -p "${CLOUD_INIT_DIR}"

    local ssh_key
    ssh_key=$(cloudinit_get_ssh_key)

    cat > "${CLOUD_INIT_DIR}/user-data" <<USERDATA
#cloud-config
# Generated by openstack-lab — do not edit manually

users:
  - name: stack
    sudo: ALL=(ALL) NOPASSWD:ALL
    shell: /bin/bash
    groups: [sudo, docker]
    ssh_authorized_keys:
      - ${ssh_key}

package_update: true
package_upgrade: true
packages:
  - python3
  - python3-pip
  - git
  - curl
  - wget
  - vim
  - qemu-guest-agent

runcmd:
  - systemctl enable qemu-guest-agent
  - systemctl start qemu-guest-agent
  - systemctl enable ssh
  - apt-get clean

final_message: "Cloud-init complete after \$UPTIME seconds"
USERDATA

    log_ok "Cloud-init user-data created"
}

# Generate meta-data
cloudinit_generate_meta_data() {
    mkdir -p "${CLOUD_INIT_DIR}"
    cat > "${CLOUD_INIT_DIR}/meta-data" <<EOF
instance-id: ${VM_NAME}
local-hostname: ${GUEST_HOSTNAME}
EOF
    log_ok "Cloud-init meta-data created"
}
